<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TongaKids.Controls"
             xmlns:vm="clr-namespace:TongaKids.ViewModels"
             x:Class="TongaKids.Views.StoryEditorPage"
             x:DataType="vm:StoryEditorViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource ScreenPadding}" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="{Binding Title}" Style="{StaticResource HeadlineLg}"
                   TextColor="{StaticResource Primary}" />
            <Label Text="{Binding Summary}" Style="{StaticResource LabelLg}"
                   TextColor="{StaticResource Tertiary}" />
            <Label Text="Type the page in Chitonga, then tap the microphone to read it aloud."
                   Style="{StaticResource BodyMd}" FontSize="13" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <Label Text="This story has no pages yet. Tap Add page to begin."
                       Style="{StaticResource BodyMd}" IsVisible="{Binding IsEmpty}"
                       HorizontalTextAlignment="Center" Margin="0,24" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pages}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageEditModel">
                            <Border Style="{StaticResource Card}" Padding="16">
                                <VerticalStackLayout Spacing="12">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="{Binding Heading}"
                                               Style="{StaticResource TitleLg}" />
                                        <Label Grid.Column="1" Text="delete"
                                               Style="{StaticResource Icon}" FontSize="24"
                                               TextColor="{StaticResource Error}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryEditorViewModel}}, Path=DeletePageCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <!-- The page text, as it will appear to the child -->
                                    <Border BackgroundColor="{StaticResource SurfaceContainerLow}"
                                            Stroke="{StaticResource OutlineVariant}"
                                            StrokeThickness="1" Padding="12,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Editor Text="{Binding Text, Mode=TwoWay}"
                                                Placeholder="Write this page in Chitonga..."
                                                AutoSize="TextChanges"
                                                MinimumHeightRequest="96" />
                                    </Border>

                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding RecordLabel}"
                                               Style="{StaticResource LabelLg}" FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               VerticalOptions="Center" />

                                        <Border Grid.Column="1" WidthRequest="48" HeightRequest="48"
                                                BackgroundColor="{StaticResource SecondaryContainer}"
                                                StrokeThickness="0" IsVisible="{Binding IsRecorded}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="24" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryEditorViewModel}}, Path=PlayCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="play_arrow" Style="{StaticResource Icon}"
                                                   FontSize="26"
                                                   TextColor="{StaticResource OnSecondaryContainer}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <Border Grid.Column="2" WidthRequest="56" HeightRequest="56"
                                                BackgroundColor="{StaticResource PrimaryContainer}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="28" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StoryEditorViewModel}}, Path=ToggleRecordCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding RecordGlyph}" Style="{StaticResource Icon}"
                                                   FontSize="28" TextColor="{StaticResource OnPrimary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:TactileButton Grid.Row="2" Text="Add page"
                                BackgroundFill="{StaticResource Secondary}"
                                DepthColor="{StaticResource OnSecondaryFixedVariant}"
                                TextColor="{StaticResource OnSecondary}"
                                Command="{Binding AddPageCommand}" />
    </Grid>
</ContentPage>
